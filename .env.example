# Copy this file to .env and adjust as needed. No secrets required for
# this project (no auth, no external API keys)

# Confidence below this marks a prediction as "Needs Human Review"
CONFIDENCE_THRESHOLD=0.55

# Max / min combined subject+body length accepted by /api/analyze
MAX_EMAIL_LENGTH=20000
MIN_EMAIL_LENGTH=3

# VADER compound score thresholds for sentiment label bucketing
SENTIMENT_NEGATIVE_THRESHOLD=-0.05
SENTIMENT_POSITIVE_THRESHOLD=0.05

# Sentiment compound score below this can bump priority up one level
# (e.g. MEDIUM -> HIGH). Sentiment never fully determines priority alone.
NEGATIVE_SENTIMENT_BOOST_THRESHOLD=-0.5

# Flask server
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Streamlit -> Flask API base URL (used when running as two separate
# services, e.g. via docker-compose or Render)
API_URL=http://127.0.0.1:5000
